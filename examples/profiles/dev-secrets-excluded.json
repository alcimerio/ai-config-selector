{
  "version": 3,
  "name": "dev-secrets-excluded",
  "common": {
    "environment": {
      "version": 1,
      "selection": {
        "entries": []
      }
    },
    "exclusions": {
      "version": 1,
      "selection": {
        "entries": [
          {
            "id": "dotenv",
            "type": "file",
            "reference": {
              "kind": "workspace-relative",
              "path": ".env"
            }
          },
          {
            "id": "dotenv-local",
            "type": "file",
            "reference": {
              "kind": "workspace-relative",
              "path": ".env.local"
            }
          },
          {
            "id": "secrets-dir",
            "type": "directory",
            "reference": {
              "kind": "workspace-relative",
              "path": "secrets"
            }
          }
        ]
      }
    },
    "executables": {
      "version": 1,
      "selection": {
        "entries": []
      }
    },
    "instructions": {
      "version": 1,
      "selection": []
    },
    "mcp": {
      "version": 1,
      "selection": {
        "servers": []
      }
    },
    "paths": {
      "version": 1,
      "selection": {
        "entries": []
      }
    },
    "skills": {
      "version": 1,
      "selection": []
    },
    "workspace": {
      "version": 1,
      "selection": {
        "access": "read-write"
      }
    }
  },
  "overlays": {
    "codex": {
      "version": 1
    },
    "devin": {
      "version": 1
    }
  }
