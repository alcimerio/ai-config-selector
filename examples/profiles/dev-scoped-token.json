{
  "version": 1,
  "name": "dev-scoped-token",
  "common": {
    "environment": {
      "version": 1,
      "selection": {
        "entries": [
          {
            "id": "build-mode",
            "destination": "BUILD_MODE",
            "scope": "attached-process-tree",
            "source": {
              "kind": "host-environment",
              "name": "ACS_EXAMPLE_BUILD_MODE"
            },
            "required": false,
            "classification": "non-secret"
          },
          {
            "id": "github-token",
            "destination": "GH_TOKEN",
            "scope": "attached-process-tree",
            "source": {
              "kind": "secret-reference",
              "provider": "host-environment",
              "reference": "ACS_EXAMPLE_GH_TOKEN"
            },
            "required": true,
            "classification": "secret"
          }
        ]
      }
    },
    "exclusions": {
      "version": 1,
      "selection": {
        "entries": []
      }
    },
    "executables": {
      "version": 1,
      "selection": {
        "entries": []
      }
    },
    "instructions": {
      "version": 1,
      "selection": []
    },
    "mcp": {
      "version": 1,
      "selection": {
        "servers": []
      }
    },
    "paths": {
      "version": 1,
      "selection": {
        "entries": []
      }
    },
    "skills": {
      "version": 1,
      "selection": []
    },
    "workspace": {
      "version": 1,
      "selection": {
        "access": "read-write"
      }
    }
  },
  "overlays": {
    "codex": {
      "version": 1
    },
    "devin": {
      "version": 1
    }
  }
}
