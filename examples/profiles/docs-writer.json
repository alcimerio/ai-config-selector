{
  "version": 1,
  "name": "docs-writer",
  "common": {
    "environment": {
      "version": 1,
      "selection": {
        "entries": []
      }
    },
    "exclusions": {
      "version": 1,
      "selection": {
        "entries": []
      }
    },
    "executables": {
      "version": 1,
      "selection": {
        "entries": []
      }
    },
    "instructions": {
      "version": 1,
      "selection": [
        {
          "source": "acs-instructions",
          "relativePath": "docs-style.md"
        }
      ]
    },
    "mcp": {
      "version": 1,
      "selection": {
        "servers": []
      }
    },
    "paths": {
      "version": 1,
      "selection": {
        "entries": [
          {
            "id": "docs",
            "access": "read-write",
            "type": "directory",
            "reference": {
              "kind": "workspace-relative",
              "path": "docs"
            }
          }
        ]
      }
    },
    "skills": {
      "version": 1,
      "selection": []
    },
    "workspace": {
      "version": 1,
      "selection": {
        "access": "read-only"
      }
    }
  },
  "overlays": {
    "codex": {
      "version": 1
    },
    "devin": {
      "version": 1
    }
  }
}
